{
  "name": "josh-arcade",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "BOARDS", "class_name": "Boards" },
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "STATS", "class_name": "Stats" },
      { "name": "CHAT", "class_name": "Chat" },
      { "name": "LOUNGE", "class_name": "Lounge" },
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "TELEMETRY", "class_name": "Telemetry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Boards", "Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Stats"] },
    { "tag": "v3", "new_sqlite_classes": ["Chat"] },
    { "tag": "v4", "new_sqlite_classes": ["Lounge"] },
    { "tag": "v5", "new_sqlite_classes": ["Lobby"] },
    { "tag": "v6", "new_sqlite_classes": ["Telemetry"] }
  ]
}
