---
import OS from '../os/OS';
import '../os/os.css';

const title = 'joshua koo';
const description = "josh's computer — stanford cs + math, coxswain, investor, builder, musician. click around.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b10" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://joshuakoo.xyz" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@joshuaykoo" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&family=Sacramento&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <OS client:load />
    <noscript>
      <div class="noscript">
        <h1>joshua koo</h1>
        <p>stanford cs + math · coxswain · investment intern @ crv</p>
        <p>
          <a href="mailto:joskoo@stanford.edu">email</a> ·
          <a href="https://x.com/joshuaykoo">x</a> ·
          <a href="https://linkedin.com/in/joshuaykoo">linkedin</a> ·
          <a href="https://github.com/jkdreamr">github</a> ·
          <a href="https://www.instagram.com/joshuaykoo/">instagram</a> ·
          <a href="https://soundcloud.com/atkelix">soundcloud</a>
        </p>
      </div>
    </noscript>
  </body>
</html>
